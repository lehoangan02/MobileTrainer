MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 798044858}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29f711673e0844d5a126f395eea952fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FoldTutorialManager
  player: {fileID: 871048049}
  titleText: {fileID: 42499326}
  instructionText: {fileID: 1631905801}
  stepCounterText: {fileID: 695843279}
  playPauseButtonText: {fileID: 2140269181}
  timelineSlider: {fileID: 1620076523}
  nextButton: {fileID: 4233654}
  prevButton: {fileID: 1305141272}
  selectScreenSceneName: TutorialSelectScreen
  steps:
  - title: Release the battery
    instruction: Grab the battery handle and rotate it until the latch releases.
    clip: {fileID: 7400000, guid: cd446337f92a5644ea5cf088e2380867, type: 2}
  - title: Lift the battery off
    instruction: Keep hold of the handle and lift the upper battery unit clear of
      the drone.
    clip: {fileID: 7400000, guid: cd446337f92a5644ea5cf088e2380867, type: 2}
  - title: Set all fan blades
    instruction: Rotate each of the eight fan blades into the folding range.
    clip: {fileID: 7400000, guid: 43cc817f8ee7e014fad7882601cb8376, type: 2}
  - title: Open the right body latch
    instruction: Grab the right body latch and swing it fully open.
    clip: {fileID: 7400000, guid: 1f4da7c952e6e884b89e6c25da6d6b44, type: 2}
  - title: Slide the right body slider
    instruction: Slide the right body slider back past its stop.
    clip: {fileID: 7400000, guid: e34eae07d5552e544b0bd008a9f3e572, type: 2}
  - title: Close the right body latch
    instruction: Swing the right body latch shut to lock the slider.
    clip: {fileID: 7400000, guid: 4e8c2cf329a7b1949b536d9ac11da89d, type: 2}
  - title: Open the left body latch
    instruction: Grab the left body latch and swing it fully open.
    clip: {fileID: 7400000, guid: 1ec222e21c18dd744a34624c76b8d0e0, type: 2}
  - title: Slide the left body slider
    instruction: Slide the left body slider back past its stop.
    clip: {fileID: 7400000, guid: b9f3cfd7f30054a4488b21b11b30f56b, type: 2}
  - title: Close the left body latch
    instruction: Swing the left body latch shut to lock the slider.
    clip: {fileID: 7400000, guid: a64d47e7baf6c5847867e18f115f9205, type: 2}
  - title: Fold both halves
    instruction: Grab both halves of the drone and rotate them inward together past
      85 degrees.
    clip: {fileID: 7400000, guid: 8781cc7ba5e806a4a9d3b65d08010eac, type: 2}
  - title: Open the front-right latch
    instruction: Grab the front-right latch and swing it fully open.
    clip: {fileID: 7400000, guid: f59f69efd1db196439404063bfac4d0d, type: 2}
  - title: Slide the front-right slider
    instruction: Slide the front-right slider back past its stop.
    clip: {fileID: 7400000, guid: 1fa3227ff7c4d6f429379dac17469599, type: 2}
  - title: Close the front-right latch
    instruction: Swing the front-right latch shut to lock the slider.
    clip: {fileID: 7400000, guid: 038c8534f8dcecb4c9d325eab78d2b04, type: 2}
  - title: Open the front-left latch
    instruction: Grab the front-left latch and swing it fully open.
    clip: {fileID: 7400000, guid: 0c4514bd620d7c1439222149a11cbabc, type: 2}
  - title: Slide the front-left slider
    instruction: Slide the front-left slider back past its stop.
    clip: {fileID: 7400000, guid: 45198c36c504d2149b77975478e5e50b, type: 2}
  - title: Close the front-left latch
    instruction: Swing the front-left latch shut to lock the slider.
    clip: {fileID: 7400000, guid: 98235673340193841a2e7f50bea6a1be, type: 2}
  - title: Fold the front arms
    instruction: Grab both front sub-arms and rotate them together past 90 degrees.
    clip: {fileID: 7400000, guid: 5913782653e1bd74db11dde7ffe75969, type: 2}
  - title: Open the back-right latch
    instruction: Grab the back-right latch and swing it fully open.
    clip: {fileID: 7400000, guid: bc5cb95bc2499b84ab244dc51c8d79b0, type: 2}
  - title: Slide the back-right slider
    instruction: Slide the back-right slider back past its stop.
    clip: {fileID: 7400000, guid: 51f9f1d88e9b00645ae55f681a211136, type: 2}
  - title: Close the back-right latch
    instruction: Swing the back-right latch shut to lock the slider.
    clip: {fileID: 7400000, guid: 59bc6de0376ddd04ea6abff430479510, type: 2}
  - title: Open the back-left latch
    instruction: Grab the back-left latch and swing it fully open.
    clip: {fileID: 7400000, guid: 9d611d564d46bfe46b25a72d54646745, type: 2}
  - title: Slide the back-left slider
    instruction: Slide the back-left slider back past its stop.
    clip: {fileID: 7400000, guid: fd790b06df2d37648a52a0131f348558, type: 2}
  - title: Close the back-left latch
    instruction: Swing the back-left latch shut to lock the slider.
    clip: {fileID: 7400000, guid: 0663982e28f98ae49890fd9deceb4c70, type: 2}
  - title: Fold the back arms
    instruction: Grab both rear sub-arms and rotate them together past 90 degrees.
    clip: {fileID: 7400000, guid: ad1e3432c1f3b6b40956f8f5695af901, type: 2}
  - title: Fold one landing gear
    instruction: Poke the button on each leg of either landing gear, then fold both
      of its legs past 85 degrees.
    clip: {fileID: 7400000, guid: 5c5f4bda5f1adbe4588b4f7ab4972674, type: 2}
  - title: Fold the other landing gear
    instruction: 'Do the same on the remaining landing gear: poke each leg button,
      then fold both legs.'
    clip: {fileID: 7400000, guid: 74b3e4e05be8eda4192b97868163a9fc, type: 2}
